            print("1.- Ver archivo alumnos.txt")
            print("2.- Ver archivo cuentas.txt")
            print("3.- Ver archivo logErrores.txt")
            print("4.- Ver los 3 archivos completos")
            opVer = input("Seleccione una opcion (1-4): ").strip()
            gestorGlobal.mostrarArchivosSistema(opVer)

        elif opcion == 12:
            #guarda todo y regresa al menu de inicio de sesion
            gestorGlobal.guardarAlumnos(coordActual.obtenerTodosLosAlumnos())
            gestorGlobal.guardarTodasLasCuentas(cuentas)
            coordActual = ""
            estadoRegistrado = 1
            print("Sesion cerrada correctamente.")

        elif opcion == 13:
            #guarda todo y cierra el programa por completo
            gestorGlobal.guardarAlumnos(coordActual.obtenerTodosLosAlumnos())
            gestorGlobal.guardarTodasLasCuentas(cuentas)
            indiceActual = 0
            print("Saliendo del sistema...")

    except ValueError as e:
        print(f"[ERROR DE VALIDACION]: {e}")
        enviarError(e)
    except Exception as e:
        print(f"[ERROR]: {e}")
        enviarError(e)

    return indiceActual, estadoRegistrado, coordActual


