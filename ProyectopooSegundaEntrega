def rectificarId(valor):
    texto = str(valor).strip()
    numeros = ""
    for caracter in texto:
        if caracter.isdigit():
            numeros += caracter
    while numeros.startswith("0") and len(numeros) > 1:
        numeros = numeros[1:]
    return numeros

#en caso de que yo ponga 00050402 en la lista aparezca 50402 porque 0050432 es lo mismo que 504221


def rectificarTexto(valor):
    texto = str(valor).strip().lower()
    resultado = ""
    for caracter in texto:
        if caracter in reemplazosTexto:
            resultado += reemplazosTexto[caracter]
        else:
            resultado += caracter
    return " ".join(resultado.split())

