                if len(alumno.obtenerRequisitos()) > 0:
                    print("Listado de requisitos GestionRe:")
                    for r in alumno.obtenerRequisitos():
                        print("  -", r)

        elif opcion == 4:
            #para modificar los datos personales o subirle actividades y mentorias
            criterioActualizar = input("Ingrese el ID o nombre del alumno a modificar: ").strip()
            alumno = coordActual.mostrarAlumno(criterioActualizar)
            print("1.- Actualizar datos personales y cambio de grupo")
            print("2.- Actualizar avance de actividades, mentorias y materias")
            subOp = input("Seleccione que desea actualizar (1 o 2): ").strip()
            if subOp == "1":
                nuevoNombre = rectificarTexto(input("Nuevo nombre: ").strip())
                nuevoSemStr = input("Nuevo semestre (1-16): ").strip()
                if not nuevoSemStr.isdigit():
                    raise ValueError("El semestre debe ser numerico")
                nuevoGrupo = seleccionarGrupoHerencia(False)
                nuevoDetalle = pedirDetalleEspecificoGrupo(nuevoGrupo)
                alumno.actualizarDatos(nuevoNombre, int(nuevoSemStr), nuevoGrupo.getNombreArea(), nuevoDetalle)
                sincronizarGrupos(coordActual.obtenerTodosLosAlumnos())
                print("Datos actualizados correctamente.")
            elif subOp == "2":
                act = input("Nuevo total de actividades: ").strip()
                ment = input("Nuevo total de mentorias: ").strip()
                oblig = input("Nuevo total de actividades obligatorias: ").strip()
                rep = input("Nuevo total de materias reprobadas: ").strip()
                if not (act.isdigit() and ment.isdigit() and oblig.isdigit() and rep.isdigit()):
                    raise ValueError("Todos los campos de progreso deben ser enteros no negativos")
                alumno.actualizarProgreso(int(act), int(ment), int(oblig), int(rep))
                print("Progreso actualizado correctamente.")
            else:
                raise ValueError("Subopcion de actualizacion invalida")
            gestorGlobal.guardarAlumnos(coordActual.obtenerTodosLosAlumnos())

        elif opcion == 5:
            #exclusivo para meterle eventos o requisitos academicos a los de GestionRe
            criterioAl = input("Ingrese el ID o nombre del alumno GestionRe: ").strip()
            alumno = coordActual.mostrarAlumno(criterioAl)
            if not isinstance(alumno, GestionRe):
                raise ValueError("El alumno seleccionado no pertenece a la modalidad GestionRe")
            print("1.- Agregar nuevo requisito (Evento o Academico)")
            print("2.- Marcar requisito existente como completado/pendiente")
            accionReq = input("Seleccione accion (1 o 2): ").strip()
            if accionReq == "1":
                tipoReq = input("Tipo de requisito (1: Evento / 2: Academico): ").strip()
                nomAct = rectificarTexto(input("Nombre del requisito: ").strip())
                perReq = input("Periodo: ").strip()
                completadoIn = input("¿Ya esta completado? (S/N): ").strip().upper()
                if completadoIn not in ("S", "N"):
                    raise ValueError("Debe indicar S o N para el estado del requisito")
                estadoBool = True if completadoIn == "S" else False

                if tipoReq == "1":
                    fechaEv = input("Fecha del evento (DD/MM/AAAA): ").strip()
                    req = RequisitoEvento(nomAct, perReq, fechaEv, estadoBool)
                elif tipoReq == "2":
                    calMinStr = input("Calificacion minima requerida (0-100): ").strip()
                    if not calMinStr.replace(".", "", 1).isdigit():
                        raise ValueError("La calificacion minima debe ser un numero valido")
                    req = RequisitoAcademico(nomAct, perReq, float(calMinStr), estadoBool)
                else:
                    raise ValueError("Tipo de requisito invalido, debe ser 1 o 2")

                alumno.agregarRequisito(req)
                gestorGlobal.guardarAlumnos(coordActual.obtenerTodosLosAlumnos())
                print("Requisito agregado y guardado:", req)
            elif accionReq == "2":
                reqs = alumno.obtenerRequisitos()
                if len(reqs) == 0:
                    raise ValueError("Este alumno no tiene requisitos especiales registrados")
                idx = 1
                for r in reqs:
                    print(f"{idx}.- {r}")
                    idx += 1
                numReqStr = input("Numero del requisito a cambiar: ").strip()
                if not numReqStr.isdigit():
                    raise ValueError("Debe ingresar un numero valido")
                numReq = int(numReqStr)
                if numReq < 1 or numReq > len(reqs):
                    raise ValueError("Numero de requisito fuera de rango")
                nuevoEst = input("¿Marcar como completado? (S/N): ").strip().upper()
                if nuevoEst not in ("S", "N"):
                    raise ValueError("Debe responder S o N")
                reqs[numReq - 1].registrarAvance(True if nuevoEst == "S" else False)
                gestorGlobal.guardarAlumnos(coordActual.obtenerTodosLosAlumnos())
                print("Estado del requisito actualizado:", reqs[numReq - 1])
            else:
                raise ValueError("Opcion no valida")

        elif opcion == 6:
            #imprime todos los que ya tienen todo listo para graduarse
            cumplidos = coordActual.mostrarAlumnosCumplimiento()
            if len(cumplidos) == 0:
                print("Ningun alumno cumple aun con todos los requisitos de graduacion.")
            else:
                print("\n--- Alumnos Listos para Graduarse ---")
                for a in cumplidos:
                    print(a, "|", a.mostrarProgreso())

        elif opcion == 7:
            #imprime los que todavia tienen pendientes y que cosas les faltan
            pendientes = coordActual.mostrarAlumnosConRequisitosPendientes()
            if len(pendientes) == 0:
                print("No hay alumnos con requisitos pendientes.")
            else:
                print("\n--- Alumnos con Requisitos Pendientes ---")
                for a in pendientes:
                    faltantes = ", ".join(a.obtenerPendientes())
                    print(f"{a.getId()} | {a.getNombre()} ({a.getArea()} - {a.getDetalleGrupo()}) | Faltan: {faltantes}")

        elif opcion == 8:
            #muestra un resumen de todo el sistema alumnos grupos y cuentas
            todos = coordActual.obtenerTodosLosAlumnos()
            sincronizarGrupos(todos)
            print("\n================ VISTA GENERAL COMPLETA DEL SISTEMA ================")
            print(f"Coordinador Activo: {coordActual}")
            print(f"Limites Minimos Vigentes -> Actividades: {limiteActividades} | Mentorias: {limiteMentorias} | Obligatorias: {limiteActividadesObligatorias}")

            misAlumnos = coordActual.mostrarAlumnosPorMisGrupos()
            print(f"\n--- Alumnos en los Grupos que Coordinas ({coordActual.area}): {len(misAlumnos)} ---")
            if len(misAlumnos) == 0:
                print("No hay alumnos inscritos en tus grupos coordinados.")
            else:
                for alMio in misAlumnos:
                    print(" ", alMio.mostrarProgreso())

