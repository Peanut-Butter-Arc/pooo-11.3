    def guardarAlumnos(self, listaAlumnos):
        try:
            with open(self.archivoAlumnos, "w", encoding="utf-8") as archivo:
                for alumno in listaAlumnos:
                    archivo.write(str(alumno) + "\n")
        except PermissionError as e:
            self.registrarError("PermissionError", str(e))
            raise ValueError("No se tienen permisos para guardar el archivo de alumnos")
        #sobreescribe alumnos.txt con la lista actualizada

    def reconstruirRequisitos(self, cadenaRequisitos):
        listaReq = []
        texto = str(cadenaRequisitos).strip()
        if texto == "" or texto == "SinRequisitos":
            return listaReq
        elementos = texto.split(";")
        for item in elementos:
            partes = item.split("~")
            if len(partes) >= 5:
                tipo = partes[0]
                nom = partes[1]
                per = partes[2]
                comp = True if partes[3] == "1" else False
                extra = partes[4]
                if tipo == "EVE":
                    reqObj = RequisitoEvento(nom, per, extra, comp)
                    listaReq.append(reqObj)
                elif tipo == "ACA":
                    cal = float(extra) if extra.replace(".", "", 1).isdigit() else 70.0
                    reqObj = RequisitoAcademico(nom, per, cal, comp)
                    listaReq.append(reqObj)
                else:
                    reqObj = Requisito(nom, per, comp)
                    listaReq.append(reqObj)
        return listaReq
        #convierte el texto del archivo otra vez en objetos de tipo requisito

