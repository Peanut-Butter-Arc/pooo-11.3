            for c in cuentas:
                if c.idNombre == coordActual.idNombre:
                    c.agregarGrupoCoordinado(grupoNuevo.getNombreArea())
            gestorGlobal.guardarTodasLasCuentas(cuentas)
            if agregado:
                print(f"Grupo '{grupoNuevo.getNombreArea()}' agregado a tu coordinacion. Ahora coordinas: {coordActual.area}")
            else:
                print(f"Configuracion de '{grupoNuevo.getNombreArea()}' actualizada. Tus grupos son: {coordActual.area}")

        elif opcion == 10:
            #cambia las variables globales de los limites minimos
            print(f"Valores actuales -> Actividades: {limiteActividades}, Mentorias: {limiteMentorias}, Obligatorias: {limiteActividadesObligatorias}")
            nAct = input("Nuevo minimo de actividades: ").strip()
            nMent = input("Nuevo minimo de mentorias: ").strip()
            nOblig = input("Nuevo minimo de actividades obligatorias: ").strip()
            if not (nAct.isdigit() and nMent.isdigit() and nOblig.isdigit()):
                raise ValueError("Los limites minimos deben ser numeros enteros no negativos")
            limiteActividades = int(nAct)
            limiteMentorias = int(nMent)
            limiteActividadesObligatorias = int(nOblig)
            print(f"Nuevas metas minimas actualizadas -> Act: {limiteActividades} | Ment: {limiteMentorias} | Oblig: {limiteActividadesObligatorias}")

        elif opcion == 11:
