    def getAlumnos(self):
        return self.alumnos
    
    #GETTERWSS  

    def obtenerTipoGrupo(self):
        return "Grupo Universitario General"

    def agregarAlumno(self, alumno):
        if alumno == "":
            raise ValueError("El alumno no existe")
        for existente in self.alumnos:
            if existente.getId() == alumno.getId():
                return True
        self.alumnos.append(alumno)
        return True

    def eliminarAlumno(self, idAlumno):
        idLimpio = rectificarId(idAlumno)
        for a in self.alumnos:
            if a.getId() == idLimpio:
                self.alumnos.remove(a)
                return True
        raise ValueError(f"El alumno con ID {idLimpio} no se encuentra en el grupo {self.nombreArea}")

    #eliminar y agregar alumno

    def __str__(self):
        return f"ID {self.idArea} | Grupo: {self.nombreArea} | Tipo: {self.obtenerTipoGrupo()} | Inscritos: {len(self.alumnos)}"

