class Alumno:

    #inicializamos todo para que se cree el alumno
    def __init__(self, idAlumno, nombre, semestre, areaDeRe, gestion, materiasReprobadas, actividades=0, mentorias=0, actividadesObligatorias=0, detalleGrupo="General"):
        idLimpio = rectificarId(idAlumno)
        nombreLimpio = rectificarTexto(nombre)
        if not idLimpio:
            raise ValueError("El ID del alumno debe contener numeros validos")
        if not nombreLimpio:
            raise ValueError("El nombre del alumno no puede estar vacio")
        if int(semestre) <= 0 or int(semestre) > 16:
            raise ValueError("El semestre debe estar entre 1 y 16")
        if str(areaDeRe).strip() not in AreaRe:
            raise ValueError(f"El grupo '{areaDeRe}' no pertenece a los grupos validos de la universidad")
        if int(materiasReprobadas) < 0:
            raise ValueError("Las materias reprobadas no pueden ser negativas")
        if int(actividades) < 0 or int(mentorias) < 0 or int(actividadesObligatorias) < 0:
            raise ValueError("Las actividades y mentorias no pueden ser numeros negativos")

        #en caso de los errores pone los errores

        self.idAlumno = idLimpio
        self.nombre = nombreLimpio
        self.semestre = int(semestre)
        self.areaDeRe = str(areaDeRe).strip()
        self.gestionRe = str(gestion).strip()
        self.materiasReprobadas = int(materiasReprobadas)
        self.actividades = int(actividades)
        self.mentorias = int(mentorias)
        self.actividadesObligatorias = int(actividadesObligatorias)
        self.detalleGrupo = str(detalleGrupo).strip() if str(detalleGrupo).strip() != "" else "General"
        #metemos todos los datos de los alumnos

    def getId(self):
        return self.idAlumno

    def getNombre(self):
        return self.nombre

    def getSemestre(self):
        return self.semestre

    def getArea(self):
        return self.areaDeRe

    def getGestionRe(self):
        return self.gestionRe

    def getDetalleGrupo(self):
        return self.detalleGrupo
    #getters y setters

    def actualizarDatos(self, nombre, semestre, areaDeRe, detalleGrupo="General"):
        nombreLimpio = rectificarTexto(nombre)
        if not nombreLimpio:
            raise ValueError("El nombre no puede estar vacio al actualizar")
        if int(semestre) <= 0 or int(semestre) > 16:
            raise ValueError("El semestre debe ser mayor a 0 y menor o igual a 16")
        if str(areaDeRe).strip() not in AreaRe:
            raise ValueError("El grupo seleccionado para actualizar no es valido")
        self.nombre = nombreLimpio
        self.semestre = int(semestre)
        self.areaDeRe = str(areaDeRe).strip()
        if str(detalleGrupo).strip() != "":
            self.detalleGrupo = str(detalleGrupo).strip()
        #actualizamos nombre semestre y grupo del alumno

    def actualizarProgreso(self, actividades, mentorias, actividadesObligatorias, materiasReprobadas):
        if int(actividades) < 0 or int(mentorias) < 0 or int(actividadesObligatorias) < 0 or int(materiasReprobadas) < 0:
            raise ValueError("Los valores de progreso no pueden ser negativos")
        self.actividades = int(actividades)
        self.mentorias = int(mentorias)
        self.actividadesObligatorias = int(actividadesObligatorias)
        self.materiasReprobadas = int(materiasReprobadas)
        #para cambiar cuantas actividades mentorias o reprobadas lleva

    def verificarActividades(self, cantidadActividades=-1):
        try:
            if cantidadActividades != -1 and cantidadActividades != "":
                cant = int(cantidadActividades)
            else:
                cant = self.actividades

            if cant < 0:
                raise ValueError("La cantidad de actividades no puede ser negativa")
            if cant < limiteActividades:
                return False
            return True
        except (TypeError, ValueError):
            raise ValueError("Error en verificar Actividades")
        #checamos si ya llego al limite de actividades normales

    def verificarMentorias(self, cantidadMentorias=-1):
        try:
            if cantidadMentorias != -1 and cantidadMentorias != "":
                cant = int(cantidadMentorias)
            else:
                cant = self.mentorias

            if cant < 0:
                raise ValueError("La cantidad de mentorias no puede ser negativa")
            if cant < limiteMentorias:
                return False
            return True
        except (TypeError, ValueError):
            raise ValueError("Error en verificar Mentorias")
        #checamos si ya cumplio con las mentorias minimas

    def verificarSituacionAcademica(self):
        try:
            if self.materiasReprobadas < 0:
                raise ValueError("Materias reprobadas invalidas")
            if self.materiasReprobadas >= 1:
                return False
            return True
        except (TypeError, ValueError):
            raise ValueError("Error en verificar situacion Academica")
        #si tiene 1 o mas reprobadas devuelve false porque no puede graduarse

    def verificarActividadesObligatorias(self):
        try:
            if self.actividadesObligatorias < 0:
                raise ValueError("Actividades obligatorias invalidas")
            if self.actividadesObligatorias < limiteActividadesObligatorias:
                return False
            return True
        except (TypeError, ValueError):
            raise ValueError("Error en verificar Actividades Obligatorias")
        #checamos las actividades obligatorias

    def verificarGraduacion(self):
        try:
            if self.verificarActividades() and self.verificarActividadesObligatorias() and self.verificarSituacionAcademica() and self.verificarMentorias():
                return "S"
            return self.obtenerPendientes()
        except Exception:
            raise ValueError("Error en verificar Actividades Graduacion")
        #si cumple todo regresa S y si no regresa la lista de lo que le falta

    def obtenerPendientes(self):
        try:
            pendientes = []
            if not self.verificarActividades():
                pendientes.append(f"Actividades ({self.actividades}/{limiteActividades})")
            if not self.verificarMentorias():
                pendientes.append(f"Mentorias ({self.mentorias}/{limiteMentorias})")
            if not self.verificarSituacionAcademica():
                pendientes.append(f"Materias Reprobadas ({self.materiasReprobadas})")
            if not self.verificarActividadesObligatorias():
                pendientes.append(f"Actividades Obligatorias ({self.actividadesObligatorias}/{limiteActividadesObligatorias})")
            return pendientes
        except Exception as e:
            enviarError(e)
            raise ValueError("Error al calcular los requisitos pendientes")
        #junta en una lista todo lo que todavia no cumple el alumno

    def mostrarProgreso(self):
        return f"{self.nombre} | Grupo: {self.areaDeRe} ({self.detalleGrupo}) | Act:{self.actividades}/{limiteActividades} | Ment:{self.mentorias}/{limiteMentorias} | Oblig:{self.actividadesObligatorias}/{limiteActividadesObligatorias} | Reprobadas:{self.materiasReprobadas}"

    def __str__(self):
        return f"{self.idAlumno}|{self.nombre}|{self.semestre}|{self.areaDeRe}|{self.gestionRe}|{self.materiasReprobadas}|{self.actividades}|{self.mentorias}|{self.actividadesObligatorias}|{self.detalleGrupo}"
