            for a in todos:
                print(" ", a)
                if isinstance(a, GestionRe):
                    print(f"    -> Directivo GestionRe | Avance Requisitos: {a.calcularPorcentajeAvance():.1f}% | Total Reqs: {len(a.obtenerRequisitos())}")
                    for r in a.obtenerRequisitos():
                        print(f"       * {r}")

            print("\n--- Estado de Todos los Grupos Estudiantiles (Herencia AreaRE) ---")
            for grp in gruposDisponibles.values():
                print(" ", grp)
                for miembro in grp.getAlumnos():
                    print(f"    -> ID: {miembro.getId()} | Nombre: {miembro.getNombre()} | Detalle: {miembro.getDetalleGrupo()} | Rol: {miembro.getGestionRe()}")

            print(f"\n--- Cuentas de Coordinadores Registradas ({len(cuentas)}) ---")
            for c in cuentas:
                print(" ", c)

        elif opcion == 9:
            #para cuando el coordinador quiere agregarse otro grupo mas a su cuenta
            print("Grupos que coordinas actualmente:", coordActual.area)
            grupoNuevo = seleccionarGrupoHerencia(True)
