            print(f"Alumno '{nuevoAlumno.getNombre()}' con ID '{nuevoAlumno.getId()}' registrado en {areaNombre} ({detalleEsp}).")

        elif opcion == 2:
            #damos de baja al alumno del catalogo del grupo y actualizamos el txt
            criterioEliminar = input("Ingrese el ID o nombre del alumno a dar de baja: ").strip()
            alumnoEncontrado = coordActual.mostrarAlumno(criterioEliminar)
            idReal = alumnoEncontrado.getId()
            coordActual.darDeBajaAlumno(idReal)
