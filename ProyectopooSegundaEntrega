        self.inicializarArchivosPublicos()

    def inicializarArchivosPublicos(self):
        for ruta in (self.archivoAlumnos, self.archivoLog, self.archivoCuentas):
            if not ruta.exists():
                with open(ruta, "w", encoding="utf-8") as archivo:
                    archivo.write("")
        #si no existen los archivos txt los crea vacios para que no de error al leerlos

    def registrarError(self, tipoError, mensaje):
        fechaHora = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        linea = f"{fechaHora} | ERROR | {tipoError}: {mensaje}\n"
        with open(self.archivoLog, "a", encoding="utf-8") as archivo:
            archivo.write(linea)
