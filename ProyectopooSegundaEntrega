class GestorArchivos:
    #clase para manejar todos los txt y que no se pierda nada al cerrar el programa
    def __init__(self, archivoAlumnos=archivoAlumnosPublico, archivoLog=archivoLogPublico, archivoCuentas=archivoCuentasPublico):
        self.archivoAlumnos = Path(archivoAlumnos)
        self.archivoLog = Path(archivoLog)
