class GestionRe(Alumno):
    #herencia de alumno para los que son directivos o de gestion
    def __init__(self, idAlumno, nombre, semestre, areaDeRe, gestion, materiasReprobadas, periodo, estatus, semestresComoAdmin=1, actividades=0, mentorias=0, actividadesObligatorias=0, requisitos="", detalleGrupo="General"):
        super().__init__(idAlumno, nombre, semestre, areaDeRe, gestion, materiasReprobadas, actividades, mentorias, actividadesObligatorias, detalleGrupo)
        if not str(periodo).strip():
            raise ValueError("El periodo de gestion no puede estar vacio")
        if not str(estatus).strip():
            raise ValueError("El estatus de gestion no puede estar vacio")
        if int(semestresComoAdmin) <= 0 or int(semestresComoAdmin) > 2:
            raise ValueError("Un miembro de GestionRe solo puede estar maximo 2 semestres como admin")
        self.periodo = str(periodo).strip()
        self.estatus = str(estatus).strip()
        self.semestresComoAdmin = int(semestresComoAdmin)
        if isinstance(requisitos, list):
            self.requisitos = requisitos
        else:
            self.requisitos = []
        #ademas de lo de alumno normal le guardamos periodo estatus y su lista de requisitos especiales

    def agregarRequisito(self, requisito):
        if not isinstance(requisito, Requisito):
            raise ValueError("El objeto agregado debe ser una instancia de Requisito")
        self.requisitos.append(requisito)

    def obtenerRequisitos(self):
        return self.requisitos

    def calcularPorcentajeAvance(self):
        if len(self.requisitos) == 0:
            return 0.0
        cumplidos = 0
        for r in self.requisitos:
            if r.verificarCumplimiento():
                cumplidos += 1
        return (cumplidos / len(self.requisitos)) * 100
        #sacamos el porcentaje de cuantos requisitos especiales ya completo

    def serializarRequisitos(self):
        if len(self.requisitos) == 0:
            return "SinRequisitos"
        partes = []
        for r in self.requisitos:
            partes.append(r.aFormatoArchivo())
        return ";".join(partes)
        #los pasamos a texto separados por punto y coma para que quepan en una sola linea del txt

    def __str__(self):
        return f"{super().__str__()}|{self.periodo}|{self.estatus}|SemestresAdmin:{self.semestresComoAdmin}|{self.serializarRequisitos()}"


class Requisito:
    #clase base para los requisitos de los de gestion
    def __init__(self, nombreActividad, periodo, completado=False):
        if not str(nombreActividad).strip():
            raise ValueError("El nombre de la actividad del requisito no puede estar vacio")
        if not str(periodo).strip():
            raise ValueError("El periodo del requisito no puede estar vacio")
        self.nombreActividad = rectificarTexto(nombreActividad)
        self.periodo = str(periodo).strip()
        self.completado = bool(completado)

    def verificarCumplimiento(self):
        return self.completado

    def obtenerEstado(self):
        if self.completado:
            return "Completado"
        return "Pendiente"

    def registrarAvance(self, estado=True):
        if not isinstance(estado, bool):
            raise ValueError("El estado del requisito debe ser booleano")
        self.completado = estado
        #cambia de pendiente a completado o al reves

    def aFormatoArchivo(self):
        est = "1" if self.completado else "0"
        return f"GEN~{self.nombreActividad}~{self.periodo}~{est}~0"

    def __str__(self):
        return f"{self.nombreActividad} ({self.periodo}) - {self.obtenerEstado()}"


class RequisitoEvento(Requisito):
    #requisito tipo evento que pide fecha
    def __init__(self, nombreActividad, periodo, fechaEvento="", completado=False):
        super().__init__(nombreActividad, periodo, completado)
        if not str(fechaEvento).strip():
            raise ValueError("La fecha del evento no puede estar vacia")
        self.fechaEvento = str(fechaEvento).strip()

    def aFormatoArchivo(self):
        est = "1" if self.completado else "0"
        return f"EVE~{self.nombreActividad}~{self.periodo}~{est}~{self.fechaEvento}"

    def __str__(self):
        return f"Evento: {super().__str__()} | Fecha: {self.fechaEvento}"


class RequisitoAcademico(Requisito):
    #requisito tipo academico que pide calificacion minima
    def __init__(self, nombreActividad, periodo, calificacionMinima=70, completado=False):
        super().__init__(nombreActividad, periodo, completado)
        if float(calificacionMinima) < 0 or float(calificacionMinima) > 100:
            raise ValueError("La calificacion minima debe estar entre 0 y 100")
        self.calificacionMinima = float(calificacionMinima)

